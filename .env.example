# MediCare Tchad — Variables de production
# Copier vers .env : cp .env.example .env

# --- Domaine ---
# URL publique du site (obligatoire pour CORS API)
FRONTEND_URL=https://medicare-td.com
# Nom de domaine (utilisé par setup-ssl.sh)
DOMAIN=medicare-td.com

# --- Base de données MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root-strong-password
MYSQL_USER=medicare
MYSQL_PASSWORD=change-me-secure-db-password

# --- JWT (min 32 caractères chacun) ---
# Générer : openssl rand -base64 48
JWT_SECRET=change-me-production-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-production-refresh-secret-32

# --- SMS (Africa's Talking — optionnel) ---
SMS_ENABLED=false
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=MEDICARE

# --- Chatbot OpenAI (optionnel — fallback local si vide) ---
OPENAI_API_KEY=

# --- Carte Google Maps (optionnel — OSM/Leaflet utilisé par défaut) ---
VITE_GOOGLE_MAPS_API_KEY=

# --- Nginx (ne pas modifier sauf bootstrap SSL) ---
# NGINX_CONFIG=nginx.bootstrap.conf

# --- Sauvegardes ---
# BACKUP_DIR=/opt/medicare-tchad/backups
