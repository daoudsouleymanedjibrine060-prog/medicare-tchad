{
  "name": "medicare-tchad",
  "private": true,
  "scripts": {
    "start:dev": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:backend": "powershell -NoProfile -Command \"Set-Location backend; npm run dev\"",
    "dev:frontend": "powershell -NoProfile -Command \"Set-Location frontend; npm run dev\"",
    "build": "powershell -NoProfile -Command \"Set-Location backend; npm run build; Set-Location ..\\frontend; npm run build\"",
    "db:seed": "powershell -NoProfile -Command \"Set-Location backend; npm run db:seed\"",
    "db:migrate": "powershell -NoProfile -Command \"Set-Location backend; npx prisma migrate deploy\"",
    "verify:api": "node scripts/verify-api.js",
    "docker:dev": "docker compose up -d",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File scripts/deploy-prod.ps1",
    "deploy:seed": "powershell -ExecutionPolicy Bypass -File scripts/deploy-prod.ps1 -Seed",
    "init:github": "powershell -ExecutionPolicy Bypass -File scripts/init-github.ps1",
    "validate:prod": "bash scripts/validate-production.sh",
    "health:check": "bash scripts/health-check.sh",
    "backup:mysql": "bash scripts/backup-mysql.sh"
  }
}
