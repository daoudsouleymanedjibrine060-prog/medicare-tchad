# Copier vers .env.deploy (gitignore) — ne jamais committer
# Aiven MySQL : mysql://USER:PASS@HOST:PORT/medicare_tchad?ssl-mode=REQUIRED
DATABASE_URL=

# https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=

# https://vercel.com/account/tokens
VERCEL_TOKEN=

# Provisoire avant deploy Vercel ; corriger apres si l'URL differe
FRONTEND_URL=https://medicare-tchad.vercel.app

# Noms par defaut (modifier si Render/Vercel utilisent d'autres hostnames)
RENDER_SERVICE_NAME=medicare-tchad-api
VERCEL_PROJECT_NAME=medicare-tchad
